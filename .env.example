# commit-trailer-guard needs no secrets and no API keys.
# These settings are optional when running the script by hand; every one can
# also be passed as a command line flag. The GitHub Action sets them for you
# from its inputs.

# Required trailer key (flag: --key)
TRAILER_KEY=Change-Source

# Regex the whole trailer value must match (flag: --value-pattern)
TRAILER_VALUE_PATTERN=(human|bot)-[a-z0-9-]+

# File listing exempt SHAs, one per line (flag: --grandfather-file)
TRAILER_GRANDFATHER_FILE=.github/trailer-grandfather.txt

# Git ref to read that file from; empty reads the working tree (flag: --grandfather-ref)
TRAILER_GRANDFATHER_REF=

# Extra exempt SHAs, comma or space separated (flag: --grandfather-shas)
TRAILER_GRANDFATHER_SHAS=

# Commit range to check: base is exclusive, head is inclusive (flags: --base, --head)
TRAILER_BASE_SHA=origin/main
TRAILER_HEAD_SHA=HEAD
